# ============================================
# SAKALAND — Variáveis de ambiente
# Copie este arquivo para .env.local e preencha
# ============================================

# MongoDB (Atlas ou self-hosted)
MONGODB_URI="mongodb+srv://usuario:senha@cluster.mongodb.net/sakaland?retryWrites=true&w=majority"

# JWT
JWT_SECRET="troque-por-uma-string-aleatoria-bem-longa-e-secreta"
JWT_EXPIRES_IN="7d"
JWT_RESET_SECRET="troque-por-outra-string-aleatoria-para-reset-de-senha"

# URL pública da aplicação (usada em e-mails e links)
NEXT_PUBLIC_APP_URL="http://localhost:3000"

# E-mail (SMTP) — usado para notificar administradores em resgates
SMTP_HOST="smtp.gmail.com"
SMTP_PORT="587"
SMTP_SECURE="false"
SMTP_USER="seu-email@gmail.com"
SMTP_PASSWORD="sua-senha-de-app"
SMTP_FROM="Sakaland <no-reply@sakaland.com>"
ADMIN_NOTIFICATION_EMAILS="admin1@sakaland.com,admin2@sakaland.com"

# WhatsApp (Twilio) — opcional, usado para notificar administradores em resgates
# Crie uma conta em https://www.twilio.com/whatsapp e ative o Sandbox ou número aprovado
TWILIO_ACCOUNT_SID=""
TWILIO_AUTH_TOKEN=""
TWILIO_WHATSAPP_FROM="whatsapp:+14155238886"
ADMIN_WHATSAPP_NUMBERS="whatsapp:+5511999999999"

# Upload de imagens (opcional — Cloudinary). Se não configurado, o app aceita URLs de imagem diretamente.
CLOUDINARY_CLOUD_NAME=""
CLOUDINARY_API_KEY=""
CLOUDINARY_API_SECRET=""

# Ambiente
NODE_ENV="development"
